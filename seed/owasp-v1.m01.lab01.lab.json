  "tests": [
    {
      "id": "adminRequest",
      "label": "Send GET https://www.lab.local/admin",
      "request": "GET /admin HTTP/1.1\nHost: www.lab.local:443\n(over HTTPS)",
      "outcomes": [
        {
          "when": {
            "all": [
              {
                "path": "applied.policyData.OWASP_Essentials.disallowedUrls",
                "some": {
                  "type": "Explicit",
                  "protocol": "HTTPS",
                  "url": "/admin"
                }
              },
              {
                "path": "applied.policyData.OWASP_Essentials.enforcementMode",
                "equals": "Blocking"
              }
            ]
          },
          "result": "blocked",
          "message": "Request rejected. Violation: Illegal URL. The requested URL was rejected. **Your support ID is: 1846290173466120**"
        },
        {
          "when": {
            "path": "applied.policyData.OWASP_Essentials.disallowedUrls",
            "some": {
              "type": "Explicit",
              "protocol": "HTTPS",
              "url": "/admin"
            }
          },
          "result": "logged",
          "message": "HTTP/1.1 200 OK. The admin page loaded. OWASP_Essentials logged an Illegal URL violation but did not block, because it is in Transparent mode."
        },
        {
          "when": {
            "path": "config.policyData.OWASP_Essentials.disallowedUrls",
            "some": {
              "type": "Explicit",
              "protocol": "HTTPS",
              "url": "/admin"
            }
          },
          "result": "allowed",
          "message": "HTTP/1.1 200 OK. The admin page loaded. The change exists in OWASP_Essentials but the policy has not been applied."
        },
        {
          "when": {
            "path": "config.policyData.OWASP_Essentials.disallowedUrls",
            "some": {
              "protocol": "HTTP",
              "url": "/admin"
            }
          },
          "result": "allowed",
          "message": "HTTP/1.1 200 OK. The admin page loaded. /admin is disallowed for HTTP, but this application runs over HTTPS on port 443."
        },
        {
          "when": {
            "path": "config.policyData.Legacy_Portal.disallowedUrls",
            "some": {
              "type": "Explicit",
              "protocol": "HTTPS",
              "url": "/admin"
            }
          },
          "result": "allowed",
          "message": "HTTP/1.1 200 OK. The admin page loaded. /admin is disallowed in Legacy_Portal, but www.lab.local is protected by OWASP_Essentials."
        }
      ],
      "default": {
        "result": "allowed",
        "message": "HTTP/1.1 200 OK. The admin page loaded. Nothing in the policy disallows /admin."
      }
    }
  ],
  "steps": [
    {
      "id": "s0",
      "text": "Go to Security › Application Security › Security Policies › Policies List and click OWASP_Essentials.",
      "check": {
        "path": "currentPolicy",
        "equals": "OWASP_Essentials"
      }
    },
    {
      "id": "s1",
      "text": "Go to Security › Application Security › URLs › Disallowed URLs › Disallowed HTTP URLs.",
      "check": {
        "all": [
          {
            "path": "currentPolicy",
            "equals": "OWASP_Essentials"
          },
          {
            "path": "visited",
            "includes": "disallowedUrls"
          }
        ]
      }
    },
    {
      "id": "s2",
      "text": "Click Create... and add an Explicit URL for admin, using the protocol the application runs on.",
      "check": {
        "path": "config.policyData.OWASP_Essentials.disallowedUrls",
        "some": {
          "type": "Explicit",
          "protocol": "HTTPS",
          "url": "/admin"
        }
      }
    },
    {
      "id": "s3",
      "text": "Open the policy's General Settings (Policies List › OWASP_Essentials). Under Learning and Blocking, set Enforcement Mode to Blocking and click Save.",
      "check": {
        "path": "config.policyData.OWASP_Essentials.enforcementMode",
        "equals": "Blocking"
      }
    },
    {
      "id": "s4",
      "text": "Click Apply Policy.",
      "check": {
        "all": [
          {
            "path": "applied.policyData.OWASP_Essentials.disallowedUrls",
            "some": {
              "type": "Explicit",
              "protocol": "HTTPS",
              "url": "/admin"
            }
          },
          {
            "path": "applied.policyData.OWASP_Essentials.enforcementMode",
            "equals": "Blocking"
          }
        ]
      }
    },
    {
      "id": "s5",
      "text": "Send the test request and confirm /admin is blocked.",
      "check": {
        "path": "tests.adminRequest",
        "equals": "blocked"
      }
    }
  ],
  "pendingText": "Changes details (not applied)",
  "policySelector": {
    "collection": "policies",
    "field": "name"
  },
  "applyScope": "policyData.$policy"
}
