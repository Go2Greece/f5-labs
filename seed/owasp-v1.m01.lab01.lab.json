      "returnTo": "disallowedUrls",
      "inlineRow": {
        "label": "URL",
        "help": "Example: /index.html"
      },
      "fields": [
        {
          "id": "type",
          "label": "Type",
          "type": "select",
          "options": [
            "Explicit",
            "Wildcard"
          ],
          "default": "Explicit"
        },
        {
          "id": "protocol",
          "label": "Protocol",
          "type": "select",
          "options": [
            "HTTP",
            "HTTPS"
          ],
          "default": "HTTP"
        },
        {
          "id": "method",
          "label": "Method",
          "type": "select",
          "options": [
            {
              "value": "",
              "label": "Select Method (Optional)..."
            },
            "GET",
            "POST",
            "PUT",
            "DELETE",
            "HEAD",
            "OPTIONS",
            "PATCH"
          ],
          "default": ""
        },
        {
          "id": "url",
          "label": "URL",
          "type": "text",
          "required": true,
          "mustStartWith": "/"
        }
      ]
    },
    "blockingSettings": {
      "type": "form",
      "path": [
        "Security",
        "Application Security",
        "Policy Building",
        "Learning and Blocking Settings"
      ],
      "title": "Learning and Blocking Settings",
      "fields": [
        {
          "id": "enforcementMode",
          "label": "Enforcement Mode",
          "type": "radio",
          "options": [
            "Transparent",
            "Blocking"
          ],
          "bind": "policy.enforcementMode",
          "help": "Transparent logs violations without blocking. Blocking rejects requests that trigger a violation set to block."
        }
      ],
      "pathText": "Security » Application Security : Policy Building : Learning and Blocking Settings"
    }
  },
  "tests": [
    {
      "id": "adminRequest",
      "label": "Send GET /admin",
      "request": "GET /admin HTTP/1.1\nHost: www.lab.local",
      "outcomes": [
        {
          "when": {
            "all": [
              {
                "path": "applied.disallowedUrls",
                "some": {
                  "type": "Explicit",
                  "protocol": "HTTP",
                  "url": "/admin"
                }
              },
              {
                "path": "applied.policy.enforcementMode",
                "equals": "Blocking"
              }
            ]
          },
          "result": "blocked",
          "message": "Request rejected. Violation: Illegal URL. The requested URL was rejected. Your support ID is: 1846290173466120"
        },
        {
          "when": {
            "path": "applied.disallowedUrls",
            "some": {
              "type": "Explicit",
              "protocol": "HTTP",
              "url": "/admin"
            }
          },
          "result": "logged",
          "message": "HTTP/1.1 200 OK. The admin page loaded. The policy logged an Illegal URL violation but did not block, because it is in Transparent mode."
        },
        {
          "when": {
            "path": "config.disallowedUrls",
            "some": {
              "type": "Explicit",
              "protocol": "HTTP",
              "url": "/admin"
            }
          },
          "result": "allowed",
          "message": "HTTP/1.1 200 OK. The admin page loaded. Your changes exist but have not been applied to the policy."
        }
      ],
      "default": {
        "result": "allowed",
        "message": "HTTP/1.1 200 OK. The admin page loaded. Nothing in the policy disallows /admin."
      }
    }
  ],
  "steps": [
    {
      "id": "s1",
      "text": "In the main menu, go to Security › Application Security › URLs › Disallowed URLs › Disallowed HTTP URLs.",
      "check": {
        "path": "visited",
        "includes": "disallowedUrls"
      }
    },
    {
      "id": "s2",
      "text": "Click Create... and add an Explicit HTTP URL for /admin.",
      "check": {
        "path": "config.disallowedUrls",
        "some": {
          "type": "Explicit",
          "protocol": "HTTP",
          "url": "/admin"
        }
      }
    },
    {
      "id": "s3",
      "text": "Go to Security › Application Security › Policy Building › Learning and Blocking Settings, set Enforcement Mode to Blocking and click Save.",
      "check": {
        "path": "config.policy.enforcementMode",
        "equals": "Blocking"
      }
    },
    {
      "id": "s4",
      "text": "Click Apply Policy.",
      "check": {
        "all": [
          {
            "path": "applied.disallowedUrls",
            "some": {
              "type": "Explicit",
              "protocol": "HTTP",
              "url": "/admin"
            }
          },
          {
            "path": "applied.policy.enforcementMode",
            "equals": "Blocking"
          }
        ]
      }
    },
    {
      "id": "s5",
      "text": "Send the test request and confirm /admin is blocked.",
      "check": {
        "path": "tests.adminRequest",
        "equals": "blocked"
      }
    }
  ],
  "pendingText": "Changes details (not applied)"
}
