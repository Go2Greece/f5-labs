            }
          },
          {
            "type": "length",
            "field": "requestLength",
            "modeField": "requestMode",
            "label": "Request Length",
            "showWhen": {
              "allowed": true
            }
          },
          {
            "type": "length",
            "field": "queryStringLength",
            "modeField": "queryStringMode",
            "label": "Query String Length",
            "showWhen": {
              "allowed": true
            }
          },
          {
            "type": "length",
