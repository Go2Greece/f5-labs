  "steps": [
    {
      "id": "s1",
      "text": "Disallow every URL under /backups, using a wildcard and the protocol the application runs on.",
      "check": {
        "path": "config.policyData.OWASP_Essentials.disallowedUrls",
        "matches": {
          "field": "url",
          "value": "/backups/site.zip",
          "where": {
            "protocol": "HTTPS"
          },
          "wildcardWhen": {
            "type": "Wildcard"
          }
        }
      }
    },
    {
      "id": "s2",
      "text": "On the policy's File Types page, create a disallowed file type for SQL files.",
      "check": {
        "path": "config.policyData.OWASP_Essentials.fileTypes",
        "some": {
          "fileType": "sql",
          "allowed": false
        }
      }
    },
    {
      "id": "s3",
      "text": "Click Apply Policy.",
      "check": {
        "all": [
          {
            "path": "applied.policyData.OWASP_Essentials.disallowedUrls",
            "matches": {
              "field": "url",
              "value": "/backups/site.zip",
              "where": {
                "protocol": "HTTPS"
              },
              "wildcardWhen": {
                "type": "Wildcard"
              }
            }
          },
          {
            "path": "applied.policyData.OWASP_Essentials.fileTypes",
            "some": {
              "fileType": "sql",
              "allowed": false
            }
          },
          {
            "path": "applied.policyData.OWASP_Essentials.enforcementMode",
            "equals": "Blocking"
          }
        ]
      }
    },
    {
      "id": "s4",
      "text": "Send all three test requests and confirm each one is blocked.",
      "check": {
        "all": [
          {
            "path": "tests.backupSql",
            "equals": "blocked"
          },
          {
            "path": "tests.backupOther",
            "equals": "blocked"
          },
          {
            "path": "tests.sqlElsewhere",
            "equals": "blocked"
          }
        ]
      }
    }
  ],
